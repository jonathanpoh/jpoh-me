{
  "name": "jpoh-me",
  "version": "1.0.0",
  "description": "Jonathan Poh's Personal Profile Website",
  "scripts": {
    "clean": "rimraf public",
    "dev:tailwind": "npx tailwindcss -i src/css/tailwind.css -o public/css/styles.css --watch",
    "dev:eleventy": "npx @11ty/eleventy --serve",
    "build:tailwind": "npx tailwindcss -i src/css/tailwind.css -o public/css/styles.css --minify",
    "build:icons": "node scripts/bundle-icons.mjs",
    "build:eleventy": "ELEVENTY_PRODUCTION=true npx @11ty/eleventy",
    "dev": "npm-run-all clean --parallel dev:*",
    "build": "NODE_ENV=production npm-run-all clean build:icons build:tailwind build:eleventy"
  },
  "repository": {
    "type": "git",
    "url": "https://jonathanpoh@bitbucket.org/jonathanpoh/jpoh-me.git"
  },
  "keywords": [
    "eleventy",
    "11ty",
    "tailwind",
    "tailwindcss"
  ],
  "author": "Jonathan Poh",
  "license": "ISC",
  "bugs": {
    "url": "https://bitbucket.org/jonathanpoh/jpoh-me/issues"
  },
  "homepage": "https://bitbucket.org/jonathanpoh/jpoh-me/",
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "eleventy-plugin-gravatar": "^1.0.1",
    "esbuild": "^0.28.0",
    "eslint": "^8.7.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.5.1",
    "rimraf": "^3.0.2",
    "tailwindcss": "^4.3.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0"
  }
}

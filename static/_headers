/*
X-Frame-Options: DENY
X-XSS-Protection: 1; mode=block
Content-Security-Policy: default-src https:; script-src 'self' 'unsafe-inline' https://kit.fontawesome.com https://plausible.io; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' 'unsafe-inline'
X-Content-Type-Options: nosniff
Referrer-Policy: strict-origin-when-cross-origin
Permissions-Policy: geolocation=(), camera=()
